    {
      "id": "opt_atime",
      "flag": "-atime",
      "label": "Access time",
      "description": "Match by access time in days",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "+30",
      "group": "time"
