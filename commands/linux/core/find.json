      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "root",
      "group": "match"
    },
    {
      "id": "opt_group",
      "flag": "-group",
      "label": "Group",
      "description": "Match by owning group name or gid",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "www-data",
      "group": "match"
    },
    {
      "id": "opt_empty",
      "flag": "-empty",
      "label": "Empty",
      "description": "Match empty files and directories",
      "type": "BOOL",
      "required": false,
      "default": false,
      "separator": null,
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": null,
      "group": "match"
    },
