{
  "meta": {
    "cmd": "find",
    "binary": "find",
    "description": "Search for files in a directory hierarchy",
    "version_flag": "--version",
    "has_subcommands": false,
    "platforms": ["linux", "macos"]
  },

  "positional": [
    {
      "id": "path",
      "label": "Path",
      "description": "Starting directory for the search",
      "placeholder": "/home or . or /",
      "type": "DIR_PATH",
      "required": false,
      "default": ".",
      "repeatable": false
    }
  ],

  "groups": [
    {
      "id": "match",
      "label": "Match Criteria",
      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "time",
      "label": "Time Filters",
      "collapsible": true,
      "collapsed_by_default": true
    },
    {
      "id": "action",
      "label": "Actions",
      "collapsible": true,
      "collapsed_by_default": true
    }
  ],

  "mutex_groups": [],

  "subcommands": [],

  "options": [
    {
      "id": "opt_name",
      "flag": "-name",
      "label": "Name",
      "description": "Match file name pattern (case-sensitive)",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "*.txt",
      "group": "match"
    },
    {
      "id": "opt_iname",
      "flag": "-iname",
      "label": "Name (case-insensitive)",
      "description": "Match file name pattern (case-insensitive)",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "*.TXT",
      "group": "match"
    },
    {
      "id": "opt_type",
      "flag": "-type",
      "label": "Type",
      "description": "File type to match",
      "type": "ENUM",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": ["f", "d", "l", "b", "c", "p", "s"],
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": null,
      "group": "match"
    },
    {
      "id": "opt_size",
      "flag": "-size",
      "label": "Size",
      "description": "Match by file size (e.g. +100M, -1k, 50c)",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "+100M",
      "group": "match"
    },
    {
      "id": "opt_perm",
      "flag": "-perm",
      "label": "Permissions",
      "description": "Match by file permissions (e.g. 755, /u=w)",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "755",
      "group": "match"
    },
    {
      "id": "opt_user",
      "flag": "-user",
      "label": "User",
      "description": "Match by owning user name or uid",
      "type": "STRING",
      "required": false,
