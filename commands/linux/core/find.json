      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": 0,
      "max": 999,
      "repeatable": false,
      "placeholder": "3",
      "group": "match"
    },
    {
      "id": "opt_mindepth",
      "flag": "-mindepth",
