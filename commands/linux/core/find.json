      "repeatable": false,
      "placeholder": null,
      "group": "action"
    },
    {
      "id": "opt_ls",
      "flag": "-ls",
      "label": "List",
      "description": "List matching files in ls -dils format",
      "type": "BOOL",
      "required": false,
      "default": false,
      "separator": null,
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
