      "description": "Minimum directory depth before processing",
      "type": "INT",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": 0,
      "max": 999,
      "repeatable": false,
      "placeholder": "1",
      "group": "match"
