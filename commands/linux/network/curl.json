      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "connection",
      "label": "Connection",
      "collapsible": true,
      "collapsed_by_default": true
    },
    {
      "id": "ssl",
      "label": "SSL/TLS",
      "collapsible": true,
      "collapsed_by_default": true
    }
