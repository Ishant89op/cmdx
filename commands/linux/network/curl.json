{
  "meta": {
    "cmd": "curl",
    "binary": "curl",
    "description": "Transfer data from or to a server using URLs",
    "version_flag": "--version",
    "has_subcommands": false,
    "platforms": ["linux", "macos", "windows"]
  },

  "positional": [
    {
      "id": "url",
      "label": "URL",
      "description": "URL to transfer data from or to",
      "placeholder": "https://example.com",
      "type": "STRING",
      "required": true,
      "default": null,
      "repeatable": false
    }
