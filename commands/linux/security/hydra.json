{
  "meta": {
    "cmd": "hydra",
    "binary": "hydra",
    "description": "Online password brute-forcing tool",
    "version_flag": "-h",
    "has_subcommands": false,
    "platforms": ["linux", "macos", "windows"]
  },

  "positional": [
    {
      "id": "target",
      "label": "Target",
      "description": "Target host or IP address",
      "placeholder": "192.168.1.1 or example.com",
      "type": "STRING",
      "required": true,
      "default": null,
      "repeatable": false
    },
    {
      "id": "service",
      "label": "Service",
      "description": "Service to attack (ssh, ftp, http-get, etc.)",
      "placeholder": "ssh",
      "type": "STRING",
      "required": true,
      "default": null,
      "repeatable": false
    }
  ],

  "groups": [
    {
      "id": "credentials",
      "label": "Credentials",
      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "tuning",
      "label": "Tuning",
      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "target",
      "label": "Target Options",
      "collapsible": true,
      "collapsed_by_default": true
    },
    {
      "id": "output",
      "label": "Output",
      "collapsible": true,
      "collapsed_by_default": true
    }
  ],

  "mutex_groups": [
    {
      "id": "login_source",
      "label": "Login source",
      "description": "Use either a single login or a login list, not both",
      "required": false
    },
    {
      "id": "password_source",
      "label": "Password source",
      "description": "Use either a single password, a password list, or a combo file",
      "required": false
    }
  ],

  "subcommands": [],

  "options": [
    {
      "id": "opt_login",
      "flag": "-l",
      "label": "Login",
      "description": "Single login name to try",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": "login_source",
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "admin",
      "group": "credentials"
    },
    {
      "id": "opt_login_list",
      "flag": "-L",
      "label": "Login list",
      "description": "File with login names to try",
      "type": "FILE_PATH",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": "login_source",
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "users.txt",
      "group": "credentials"
    },
    {
      "id": "opt_password",
      "flag": "-p",
      "label": "Password",
      "description": "Single password to try",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": "password_source",
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "password123",
      "group": "credentials"
    },
    {
      "id": "opt_password_list",
      "flag": "-P",
      "label": "Password list",
      "description": "File with passwords to try",
      "type": "FILE_PATH",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": "password_source",
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "/usr/share/wordlists/rockyou.txt",
      "group": "credentials"
    },
    {
      "id": "opt_combo",
      "flag": "-C",
      "label": "Combo file",
      "description": "Colon-separated login:pass file",
      "type": "FILE_PATH",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": "password_source",
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "combo.txt",
      "group": "credentials"
    },
    {
      "id": "opt_extra_checks",
      "flag": "-e",
      "label": "Extra checks",
      "description": "Try n=null password, s=login as password, r=reverse login",
      "type": "STRING",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "nsr",
      "group": "credentials"
    },
    {
      "id": "opt_threads",
      "flag": "-t",
      "label": "Threads",
      "description": "Number of parallel connections per target",
      "type": "INT",
      "required": false,
      "default": "16",
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": 1,
      "max": 256,
      "repeatable": false,
      "placeholder": null,
      "group": "tuning"
    },
    {
      "id": "opt_exit_first",
      "flag": "-f",
      "label": "Exit on first found",
      "description": "Exit when a login/pass pair is found",
      "type": "BOOL",
      "required": false,
      "default": false,
      "separator": null,
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": null,
      "group": "tuning"
    },
    {
      "id": "opt_loop_users",
      "flag": "-u",
      "label": "Loop around users",
      "description": "Try each password for all users before moving to next password",
      "type": "BOOL",
      "required": false,
      "default": false,
      "separator": null,
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": null,
      "group": "tuning"
    },
    {
      "id": "opt_port",
      "flag": "-s",
      "label": "Port",
      "description": "Target port if non-default",
      "type": "INT",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": 1,
      "max": 65535,
      "repeatable": false,
      "placeholder": null,
      "group": "target"
    },
    {
      "id": "opt_verbose",
      "flag": "-v",
      "label": "Verbose",
      "description": "Verbose mode showing login+pass for each attempt",
      "type": "BOOL",
      "required": false,
      "default": false,
      "separator": null,
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": null,
      "group": "output"
    },
    {
      "id": "opt_very_verbose",
      "flag": "-V",
      "label": "Very verbose",
      "description": "Show login+pass for each attempt in detail",
      "type": "BOOL",
      "required": false,
      "default": false,
      "separator": null,
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": null,
      "group": "output"
    },
    {
      "id": "opt_output_file",
      "flag": "-o",
      "label": "Output file",
      "description": "Write found login/password pairs to file",
      "type": "FILE_PATH",
      "required": false,
      "default": null,
      "separator": " ",
      "depends_on": null,
      "mutex_group": null,
      "choices": null,
      "min": null,
      "max": null,
      "repeatable": false,
      "placeholder": "hydra_results.txt",
      "group": "output"
    }
  ]
}
