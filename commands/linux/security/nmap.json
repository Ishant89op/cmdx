{
  "meta": {
    "cmd": "nmap",
    "binary": "nmap",
    "description": "Network exploration and security auditing tool",
    "version_flag": "--version",
    "has_subcommands": false,
    "platforms": ["linux", "macos", "windows"]
  },

  "positional": [
    {
      "id": "target",
      "label": "Target",
      "description": "Target host, IP address, or network range to scan",
      "placeholder": "192.168.1.0/24 or scanme.nmap.org",
      "type": "STRING",
      "required": true,
      "default": null,
      "repeatable": false
    }
  ],

  "groups": [
    {
      "id": "scan",
      "label": "Scan Techniques",
      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "detection",
      "label": "Service/OS Detection",
      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "timing",
      "label": "Timing and Performance",
      "collapsible": true,
      "collapsed_by_default": true
    },
    {
      "id": "output",
      "label": "Output",
      "collapsible": true,
      "collapsed_by_default": true
    },
    {
      "id": "target",
      "label": "Target Specification",
      "collapsible": true,
      "collapsed_by_default": true
    }
  ],

  "mutex_groups": [
    {
      "id": "scan_type",
      "label": "Scan type",
      "description": "Only one TCP scan type can be active at a time",
      "required": false
    },
    {
      "id": "timing_template",
      "label": "Timing template",
      "description": "Only one timing template can be used",
      "required": false
    }
  ],

