{
  "meta": {
    "cmd": "ls",
    "binary": "ls",
    "description": "List directory contents",
    "version_flag": "--version",
    "has_subcommands": false,
    "platforms": ["linux", "macos"]
  },

  "positional": [
    {
      "id": "path",
      "label": "Path",
      "description": "File or directory to list",
      "placeholder": "/home/user  or  .  or  ~",
      "type": "DIR_PATH",
      "required": false,
      "default": ".",
      "repeatable": true
    }
  ],

  "groups": [
    {
      "id": "filter",
      "label": "Filter",
      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "format",
      "label": "Format",
      "collapsible": true,
      "collapsed_by_default": false
    },
    {
      "id": "sort",
      "label": "Sort",
      "collapsible": true,
      "collapsed_by_default": true
    },
    {
      "id": "time",
      "label": "Time",
      "collapsible": true,
      "collapsed_by_default": true
    }
  ],

  "mutex_groups": [
    {
      "id": "sort_method",
      "label": "Sort method",
      "description": "Only one sort method can be active at a time",
      "required": false
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "Only one output format can be active at a time",
      "required": false
    },
    {
      "id": "time_type",
      "label": "Time type",
      "description": "Only one time field can be shown at a time",
      "required": false
    }
  ],

  "subcommands": [],

